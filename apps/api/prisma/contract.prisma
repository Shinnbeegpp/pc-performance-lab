// use prisma-8

model Cpu {
  id                String   @id @default(cuid(2))
  slug              String   @unique

  brand             String
  model             String
  fullName          String
  socket            String

  cores             Int
  threads           Int

  baseClockGHz      Real?
  boostClockGHz     Real?

  powerDrawWatts    Int?

  overallScore      Real?
  gamingScore       Real?
  productivityScore Real?

  passmarkScore     Real?
  nanoreviewScore   Real?

  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAt()

  @@index([brand])
  @@index([socket])
  @@index([fullName])
}

model Gpu {
  id                  String   @id @default(cuid(2))
  slug                String   @unique

  brand               String
  model               String
  fullName            String

  vramGB              Int
  memoryType          String?

  powerDrawWatts      Int?
  recommendedPsuWatts Int?

  overallScore        Real?
  gamingScore         Real?
  productivityScore   Real?

  passmarkScore       Real?
  nanoreviewScore     Real?

  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()

  @@index([brand])
  @@index([fullName])
}